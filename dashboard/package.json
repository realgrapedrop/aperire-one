{
  "name": "xrpl-dashboard-v4-mockup",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "start": "tsx server.ts",
    "proxy": "tsx rippled-admin-proxy.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node tools/tmp-guard.mjs node --import tsx --import ./test/support/tmp-sweep.mjs --test test/unit/*.test.ts",
    "test:e2e": "node tools/tmp-guard.mjs node --import tsx --import ./test/support/tmp-sweep.mjs --test test/e2e/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "playwright": "1.58.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.9.0",
    "geoip-lite": "^1.4.10",
    "js-yaml": "^4.1.1",
    "resend": "^6.12.2",
    "ws": "^8.21.3"
  }
}
